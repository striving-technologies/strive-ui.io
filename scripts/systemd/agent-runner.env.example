# StriveUI SDLC agent runner — environment for the systemd units / cron.
# Copy to `agent-runner.env` (same dir) and fill in. That real file is gitignored
# because it holds a secret — keep it chmod 600.
#
#   cp agent-runner.env.example agent-runner.env && chmod 600 agent-runner.env

# --- Auth: usually NOT needed. If you've already run `claude login`/`setup-token` as THIS user,
#     `claude` reuses ~/.claude/.credentials.json (file-based, auto-refreshed) and a same-user
#     systemd service inherits it — leave this unset. Only set it on machines with no interactive
#     login (CI, containers, a different service user). Value comes from `claude setup-token`. ---
# CLAUDE_CODE_OAUTH_TOKEN=

# --- PATH: user systemd services start with a minimal PATH. List every dir holding
#     claude, gh, git, node/yarn. Adjust to your machine (`which claude gh yarn` to find them). ---
PATH=%h/.local/bin:%h/.nvm/versions/node/current/bin:/usr/local/bin:/usr/bin:/bin

# --- Optional tuning (defaults shown) ---
AGENT_MAX_OPEN_PRS=5      # cap on open flow PRs + in-flight issues
AGENT_CONCURRENCY=3       # issues processed in parallel
AGENT_MAX_ITER=5          # engineer↔QA iterations per issue
# AGENT_PR_REVIEWER=your-github-login   # request review on each PR
# AGENT_YOLO=1            # skip permission prompts (safe-ish: each run is in an isolated worktree)
